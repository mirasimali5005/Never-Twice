# Evaluator environment. Names only; never commit values.
# The evaluator reads ONLY evaluator/.env (never the root .env) and has no MongoDB variable.
#
# Load it with Node's built-in env-file flag, from the repository root:
#   node --env-file=evaluator/.env evaluator/src/cli.ts check --run <run_id>
# or from inside evaluator/:
#   npm run check -- --run <run_id>        (uses --env-file-if-exists=.env)
#
# Simulator base URL, e.g. http://127.0.0.1:4010
EVAL_SIM_URL=
# Read-only key; the simulator accepts it as NT_SIM_EVAL_READ_KEY. Sent as Authorization: Bearer <key>.
EVAL_SIM_READ_KEY=
# Stripe restricted test key (rk_test_...). Used by the Stripe ledger reader (task F4, not yet implemented).
EVAL_STRIPE_KEY=
