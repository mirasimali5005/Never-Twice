{
  "name": "never-twice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Never Twice: the claims desk that refuses to guess.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint:boundaries": "vitest run --project unit tests/boundaries.test.ts",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "test:evaluator": "node --test \"evaluator/test/**/*.test.ts\"",
    "db:up": "node scripts/db-up.ts",
    "db:down": "node scripts/db-down.ts",
    "db:init": "tsx --env-file-if-exists=.env packages/db/src/init-cli.ts",
    "sim": "node --env-file-if-exists=.env apps/provider-sim/src/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "run:arm": "tsx --env-file-if-exists=.env apps/runner/src/cli.ts",
    "run:control": "node --env-file-if-exists=.env packages/baselines/src/control-cli.ts",
    "reconcile": "tsx --env-file-if-exists=.env apps/reconciler/src/cli.ts",
    "evaluator:manifest": "node --env-file-if-exists=evaluator/.env evaluator/src/cli.ts manifest",
    "evaluator:check": "node --env-file-if-exists=evaluator/.env evaluator/src/cli.ts check",
    "desk": "concurrently -k -n api,ui -c blue,green \"tsx --env-file-if-exists=.env apps/desk-api/src/server.ts\" \"pnpm --filter @nt/desk-ui dev\"",
    "sweep:kill": "node scripts/kill-sweep.ts",
    "sweep:concurrency": "node -e \"console.error('TO IMPLEMENT: sweep:concurrency (task H3)');process.exit(1)\"",
    "sweep:mutations": "node -e \"console.error('TO IMPLEMENT: sweep:mutations (task H3)');process.exit(1)\"",
    "demo:reset": "node --env-file-if-exists=.env scripts/reset.ts",
    "demo:start": "node --env-file-if-exists=.env scripts/launcher.ts",
    "demo:go": "node --env-file-if-exists=.env scripts/go.ts",
    "demo:resume": "tsx --env-file-if-exists=.env scripts/demo/resume.ts",
    "demo:audit": "tsx --env-file-if-exists=.env scripts/demo/audit.ts",
    "demo:late-commit": "tsx --env-file-if-exists=.env scripts/demo/late-commit.ts",
    "demo:replay": "tsx --env-file-if-exists=.env scripts/demo/replay.ts",
    "demo:record": "tsx --env-file-if-exists=.env scripts/demo/record.ts",
    "demo:tty": "node --env-file-if-exists=.env scripts/tty.ts",
    "check:safety": "node --env-file-if-exists=.env scripts/check-safety.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
