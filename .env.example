# Never Twice environment (HANDOVER section 5.2). Copy to .env and fill in the secrets.
# .env is git-ignored. This file holds names and non-secret defaults only: never put a real value here.
# Processes read .env through Node's --env-file flag and validate it with Zod at start-up
# (loadEnv in @nt/contracts); a process refuses to start on a missing or malformed value.
# Ports: provider simulator 4010, desk API 4020, desk UI 5173.

# ---------------------------------------------------------------- all processes
# Environment name: "local" (Docker / in-memory replica set) or "sandbox" (event Atlas sandbox).
NT_ENV=local

# ---------------------------------------------------------------- MongoDB (system processes and scripts; never the evaluator)
# Default (owner) connection string. pnpm db:init, pnpm seed and pnpm demo:reset always use this one. Secret when it carries a password.
NT_MONGODB_URI=
# OPTIONAL least-privilege override for the gateway role; empty means NT_MONGODB_URI.
NT_MONGODB_URI_GATEWAY=
# OPTIONAL least-privilege override for the agent role; empty means NT_MONGODB_URI.
NT_MONGODB_URI_AGENT=
# OPTIONAL least-privilege override for the investigator role; empty means NT_MONGODB_URI.
NT_MONGODB_URI_INVESTIGATOR=
# OPTIONAL least-privilege override for the desk API role; empty means NT_MONGODB_URI.
NT_MONGODB_URI_DESK=
# Database name.
NT_DB_NAME=never_twice

# ---------------------------------------------------------------- model (agents, investigator)
# Model backend: "cli" (default; runs the local `claude` command under your Claude Code login, no API key) or "sdk".
NT_MODEL_BACKEND=cli
# Model id; never append a date suffix. With the cli backend it is passed to --model.
NT_MODEL=claude-opus-5-5
# Model mode: "live", "record" or "replay" (set per process by the scripts; runner replay, reconciler live).
NT_MODEL_MODE=live
# Directory of recorded model outputs (cassettes).
NT_MODEL_CASSETTE_DIR=fixtures/cassettes
# OPTIONAL secret: needed ONLY when NT_MODEL_BACKEND=sdk. Never read by gateway, simulator, evaluator or UI.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- provider simulator
# The four simulator keys below are local random strings you generate yourself (openssl rand -hex 16);
# none is a real credential. The simulator learns all four from these variables at start.
# Simulator base URL used by the system.
NT_SIM_URL=http://127.0.0.1:4010
# Secret: provider write credential. Gateway, reconciler and baselines only.
NT_SIM_WRITE_KEY=
# Secret: read-only key for the investigator and the desk API.
NT_SIM_READ_KEY=
# Secret: fault scheduling and reset. Simulator and test harness only.
NT_SIM_ADMIN_KEY=
# Secret: the evaluator's read key as the simulator knows it (simulator only); same value as EVAL_SIM_READ_KEY in evaluator/.env.
NT_SIM_EVAL_READ_KEY=

# ---------------------------------------------------------------- Stripe (test mode only)
# Stripe ticket-refund leg is required; "false" only for no-network tests.
NT_STRIPE_ENABLED=true
# Secret: gateway, reconciler and seed script. Must match ^(sk|rk)_test_ ; the process exits on anything else.
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------- runs (set by scripts; leave empty)
# Run id of the current execution run (runner, reconciler).
NT_RUN_ID=
# Arm of the current run (runner, reconciler).
NT_ARM=
# Test and demo only: crash barrier spec, NAME:n or NAME@effect_key (HANDOVER section 16).
NT_CRASH_AT=
# Test and demo only: mutation id M1..M5 (HANDOVER section 16).
NT_MUTATION=

# ---------------------------------------------------------------- timing (gateway, reconciler); invariant: dispatch timeout < lease
# Lease length in milliseconds.
NT_LEASE_MS=8000
# Provider dispatch timeout in milliseconds.
NT_DISPATCH_TIMEOUT_MS=3000
# Reconciler poll interval in milliseconds.
NT_RECONCILE_INTERVAL_MS=1000
# Margin before an idempotency key's expiry, in milliseconds.
NT_KEY_MARGIN_MS=60000
# Investigator timeout in milliseconds (reconciler; two CLI calls; 12000 is enough with the sdk backend).
NT_INVESTIGATOR_TIMEOUT_MS=45000

# ---------------------------------------------------------------- Tier 2 embeddings (OPTIONAL)
# OPTIONAL secret: Voyage AI key from the organisers' allowance; only for Tier 2 Vector Search.
VOYAGE_API_KEY=

# ---------------------------------------------------------------- evaluator
# EVAL_SIM_URL, EVAL_SIM_READ_KEY and EVAL_STRIPE_KEY belong in evaluator/.env only (see evaluator/.env.example,
# owned by task F2). The evaluator has no MongoDB variable at all.
# Investigator model mode for the reconciler (default live; intake can replay while investigation runs live)
NT_INVESTIGATOR_MODEL_MODE=live
